<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Google sign-in support. If `dotnet restore` can't resolve this exact version, run
         `dotnet add package Microsoft.AspNetCore.Authentication.Google` to pick up whatever
         version currently matches your installed .NET 10 SDK. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
  </ItemGroup>

</Project>
